# Business branding (swap these per client/trade — no code changes needed)
BUSINESS_NAME="Aster & Co."
BUSINESS_TAGLINE="Local, reliable, booked in minutes."
BUSINESS_ABOUT="We have been serving Cambourne and the surrounding villages for years."

# Stripe (leave blank to run in demo mode — bookings auto-confirm with no real charge)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL Stripe redirects back to after checkout (set to your deployed URL)
PUBLIC_URL=http://localhost:3000

# Simple shared token to view /api/admin/bookings?token=...
ADMIN_TOKEN=changeme

# Optional flat cancellation fee (GBP) applied when an admin cancels a booking. 0 disables it.
CANCELLATION_FEE_GBP=0

PORT=3000
