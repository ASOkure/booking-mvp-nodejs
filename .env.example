# Postgres connection string. On Render, use the "Internal Database URL"
# from your Postgres instance's dashboard. For local dev, e.g.:
# postgresql://postgres:yourpassword@localhost:5432/booking
DATABASE_URL=

# Only read by migrate-legacy-data.js as defaults for the one business it
# creates — not used at runtime otherwise (business details now live in the DB).
BUSINESS_NAME="Aster & Co."
BUSINESS_TAGLINE="Local, reliable, booked in minutes."
BUSINESS_ABOUT="We have been serving Cambourne and the surrounding villages for years."

# Stripe (leave blank to run in demo mode — bookings auto-confirm with no real charge)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public URL Stripe redirects back to after checkout (set to your deployed URL)
PUBLIC_URL=http://localhost:3000

# Signs admin login JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Shared secret required to create a new business via POST /api/platform/businesses.
PLATFORM_ADMIN_KEY=

# Business slug that "/" redirects to (set after running migrate-legacy-data.js
# or creating your first business via the platform endpoint).
DEFAULT_BUSINESS_SLUG=

# Optional flat cancellation fee (GBP) applied when an admin cancels a booking. 0 disables it.
CANCELLATION_FEE_GBP=0

# SMS booking reminders (24h and 1h before) via Twilio. Leave blank to skip
# sending — reminders just get logged instead. Get these from
# https://console.twilio.com after creating a Twilio account.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

PORT=3000
